# Environment variables untuk portofolio
# Salin file ini menjadi `.env.local` lalu isi nilainya.

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX) — untuk kirim event
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Opsional: URL publik setelah deploy
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GA4 Data API — untuk diagram batang di /dashboard
# Property ID = angka di Admin → Property settings (bukan G-...)
GA_PROPERTY_ID=
# Service account dari Google Cloud (JSON key)
GA_CLIENT_EMAIL=
# Private key dari JSON; biarkan \n sebagai teks di satu baris
GA_PRIVATE_KEY=
